# Application
APP_NAME=Sistema de Gestao ETE
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=6060
# Origens autorizadas para dev local e VM fixa.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://192.168.7.32:5174

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ete_management
DB_USERNAME=ete_user
DB_PASSWORD=replace_with_database_password

# PostgreSQL container
POSTGRES_PORT=5432

# JWT
JWT_SECRET=replace_with_a_random_secret_with_at_least_32_characters
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Initial admin user
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_initial_admin_password

# Shift configuration
SHIFT_DAY_START=05:00
SHIFT_NIGHT_START=17:00

# Station seed
STATION_NOVO_HORIZONTE_NAME=ETE Novo Horizonte
STATION_BOA_VISTA_NAME=ETE Boa Vista

# Notification configuration
NOTIFICATION_SHIFT_REMINDER_MINUTES=10
NOTIFICATION_MEASUREMENT_INTERVAL_MINUTES=60
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Frontend
# Acesso LAN/VM: frontend em http://192.168.7.32:5174.
# Rebuild necessario apos alterar VITE_API_URL porque o Vite embute esse valor no bundle.
VITE_API_URL=http://localhost:6060/api
VITE_APP_NAME=Sistema de Gestao ETE
VITE_DEFAULT_STATION_MODE=consolidated
